# URL público da app (usado nos links de aprovação e no callback de pagamento)
APP_URL=http://localhost:3000

# Segredo das sessões (mín. 32 caracteres). Gere com: openssl rand -hex 32
AUTH_SECRET=

# Postgres. Sem isto, em desenvolvimento usa PGlite em ./.data/pglite
# DATABASE_URL=postgres://user:pass@host:5432/aprova
# DATABASE_SSL=false   # só para Postgres local sem SSL

# Pasta dos ficheiros enviados (artes/vídeos). Em produção use um disco persistente.
# UPLOAD_DIR=/var/data/uploads

# Pagamentos Multicaixa Express via vPOS (EMIS GPO).
# Sem VPOS_TOKEN, em desenvolvimento os pagamentos são simulados.
# VPOS_TOKEN=
# VPOS_POS_ID=
# PAYMENTS_CALLBACK_SECRET=   # opcional; por omissão usa AUTH_SECRET
